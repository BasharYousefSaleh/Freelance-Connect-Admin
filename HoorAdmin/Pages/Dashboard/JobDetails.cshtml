@page "{id}"
@model HoorAdmin.Pages.Dashboard.JobDetailsModel
@{
    Layout = "~/Pages/Dashboard/Shared/_Layout.cshtml";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<div class="container mt-5" >
    <!-- العنوان الرئيسي -->
    <div class="card shadow-lg border-0">
            <div class="bg-gradient-dark shadow-dark border-radius-lg pt-4 pb-3">
                <h6 class="text-white text-capitalize ps-3" style="text-align:center"> إدارة الوظائف </h6>
            </div>
       

        <div class="card-body">
            <!-- معلومات الوظيفة -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-id-badge me-2"></i><strong>    رقم الوظيفة :</strong></h5>
                            <p class="text-muted">@Model.Job.Id</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-briefcase me-2"></i><strong>  العنوان:</strong></h5>
                            <p class="text-muted">@Model.Job.Title</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-info-circle me-2"></i><strong>  الحالة:</strong></h5>
                            <p>
                                @switch (Model.Job.Status)
                                {
                                    case 1:
                                        <span class="badge bg-success">مفتوح</span>
                                        ; break;
                                    case 2:
                                        <span class="badge bg-warning text-dark">في عقد</span>
                                        ; break;
                                    case 3:
                                        <span class="badge bg-danger">مغلق</span>
                                        ; break;
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-dollar-sign me-2"></i><strong>  الميزانية:</strong></h5>
                            <p class="text-muted">@Model.Job.Budget.ToString("C")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-align-left me-2"></i><strong>  الوصف:</strong></h5>
                            <p class="text-muted text-justify">@Model.Job.Description</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-list-alt me-2"></i><strong>  التصنيف:</strong></h5>
                            <p class="text-muted">@Model.Job.Category.Name</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-calendar-alt me-2"></i><strong> تاريخ الإنشاء:</strong></h5>
                            <p class="text-muted">@Model.Job.CreatedOn.ToString("yyyy-MM-dd")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <h5><i class="fas fa-user-tie me-2"></i><strong> صاحب العمل:</strong></h5>
                            <p class="text-muted">@Model.Job.Employer.FirstName @Model.Job.Employer.LastName</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- معلومات المستقل -->
            @if (Model.Freelancer != null)
            {
                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="text-primary border-bottom pb-2"><i class="fas fa-user-check me-2"></i>  تفاصيل المستقل</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6><strong>اسم المستقل:</strong></h6>
                                        <p>@Model.Freelancer.FirstName @Model.Freelancer.LastName</p>
                                    </div>
                                    <div class="col-md-6">
                                        <h6><strong>البريد الإلكتروني:</strong></h6>
                                        <p>@Model.Freelancer.Email</p>
                                    </div>
                                    <div class="col-md-6">
                                        <h6><strong>تاريخ قبول العمل:</strong></h6>
                                        <p>@Model.Job.Contracts.First().CreatedOn.ToString("yyyy-MM-dd")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center mt-4">
                    <h5 class="text-danger"><i class="fas fa-exclamation-circle me-2"></i>لم يتم تعيين مستقل لهذه الوظيفة بعد.</h5>
                </div>
            }
        </div>
    </div>
</div>


